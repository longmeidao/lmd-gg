---
import PostView from '@/components/feed/PostView.astro';
import CollectionView from '@/components/feed/CollectionView.astro';
import { buildCollectionIndex } from '@/helpers/collection';
import {
  byPubDateDesc,
  findRelatedPosts,
  getSitePosts,
  groupPostThreads,
} from '@/helpers/content';
import { getPageCount, getPageSize } from '@/helpers/pagination';

/**
 * 站点根下的唯一动态路由：条目和合集都没有前缀，共用这一个 slug 空间。
 * `/a-chuni-manifesto` 是条目，`/凉宫春日` 是合集，靠 getStaticPaths 分流。
 */
export async function getStaticPaths() {
  const postEntries = await getSitePosts();

  const postPaths = postEntries.map((post) => {
    const relatedPosts = findRelatedPosts(post, postEntries);

    return {
      params: { slug: post.id },
      props: { type: 'post' as const, post, relatedPosts },
    };
  });

  const sorted = [...postEntries].sort(byPubDateDesc);
  const takenSlugs = new Set(postPaths.map((entry) => entry.params.slug));

  const pageSize = getPageSize();
  const collectionPaths = buildCollectionIndex(sorted).flatMap((entry) => {
    // 合集 slug 撞上条目 slug 时让条目胜出，并在构建日志里说清楚
    if (takenSlugs.has(entry.slug)) {
      console.warn(
        `[routes] 合集「${entry.name}」的 slug "${entry.slug}" 与同名条目冲突，` +
          `该合集页已跳过。请在 slate.config.ts 的 collectionSlugs 里改个 slug。`,
      );
      return [];
    }

    const totalPages = getPageCount(
      groupPostThreads(entry.items).length,
      pageSize,
    );
    return Array.from({ length: totalPages }, (_, index) => {
      const page = index + 1;
      const slug = page === 1 ? entry.slug : `${entry.slug}/page/${page}`;
      if (takenSlugs.has(slug)) {
        console.warn(
          `[routes] 合集「${entry.name}」的分页路径 "${slug}" 与条目或其他合集冲突，` +
            `该分页已跳过。请调整 collectionSlugs 或冲突条目的 slug。`,
        );
        return null;
      }
      takenSlugs.add(slug);
      return {
        params: { slug },
        props: {
          type: 'collection' as const,
          name: entry.name,
          count: entry.count,
          ids: entry.items.map((post) => post.id),
          page,
        },
      };
    }).filter((path) => path !== null);
  });

  return [...postPaths, ...collectionPaths];
}

type Props = Awaited<ReturnType<typeof getStaticPaths>>[number]['props'];

const props = Astro.props as Props;
---

{
  props.type === 'collection' ? (
    <CollectionView
      name={props.name}
      count={props.count}
      ids={props.ids}
      page={props.page}
    />
  ) : (
    <PostView post={props.post} relatedPosts={props.relatedPosts} />
  )
}
