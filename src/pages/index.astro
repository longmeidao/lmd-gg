---
import { getCollection, render } from 'astro:content';
import PageLayout from '@/components/layouts/PageLayout.astro';
import PostActions from '@/components/admin/PostActions.astro';
import PostEntry from '@/components/feed/PostEntry.astro';
import { getPostDisplayTitle, getPostPath } from '@/helpers/post';
import slateConfig from '~@/slate.config';
import '@/assets/style/home.css';

const showPrototypes =
  import.meta.env.DEV || import.meta.env.SHOW_PROTOTYPES === 'true';
const postCollection = await getCollection(
  'post',
  ({ data }) =>
    (showPrototypes || data.draft !== true) && data.hiddenFromLatest !== true,
);

const posts = await Promise.all(
  [...postCollection]
    // 置顶的排在最前，其余按发布时间倒序
    .sort(
      (a, b) =>
        Number(b.data.pinned ?? false) - Number(a.data.pinned ?? false) ||
        (b.data.pubDate?.getTime() ?? 0) - (a.data.pubDate?.getTime() ?? 0),
    )
    .map(async (post) => {
      const { Content } = await render(post);
      return {
        id: post.id,
        url: getPostPath(post.id),
        data: post.data,
        Content,
      };
    }),
);

const seenThreads = new Set<string>();
const postGroups: Array<{
  thread?: string;
  items: (typeof posts)[number][];
}> = [];

posts.forEach((post) => {
  const thread = post.data.thread;

  if (!thread) {
    postGroups.push({ items: [post] });
    return;
  }

  if (seenThreads.has(thread)) return;
  seenThreads.add(thread);
  postGroups.push({
    thread,
    items: posts
      .filter((candidate) => candidate.data.thread === thread)
      .sort(
        (a, b) =>
          (a.data.pubDate?.getTime() ?? 0) - (b.data.pubDate?.getTime() ?? 0),
      ),
  });
});
---

<PageLayout>
  <main class="home-column">
    <section class="relative mb-14">
      <h1 class="home-hero-title text-slate12">
        <a href="/">{slateConfig.title}</a>
      </h1>
      <nav class="home-nav mt-5" aria-label="站点导航">
        {
          slateConfig.navigations?.map((navigation) => (
            <a href={navigation.href}>{navigation.label}</a>
          ))
        }
      </nav>
    </section>

    <section id="post-list-section" class="mb-16 scroll-mt-8">
      <div id="post-list" class="home-feed" aria-live="polite">
        {
          postGroups.map((group, groupIndex) => (
            <div class="home-feed-cluster" data-feed-cluster>
              {groupIndex > 0 && (
                <div class="home-group-divider" aria-hidden="true" />
              )}
              <section
                class="home-feed-group"
                data-feed-group
                data-thread-group={group.thread}
                data-visible-count={group.items.length}
                aria-label={
                  group.thread
                    ? `${group.items.length} 条关联内容`
                    : getPostDisplayTitle(group.items[0]!.data)
                }
              >
                {group.items.map((item, itemIndex) => (
                  <PostEntry
                    item={item}
                    isFirst={itemIndex === 0}
                    isLast={itemIndex === group.items.length - 1}
                    isThreadLatest={
                      !!group.thread && itemIndex === group.items.length - 1
                    }
                  >
                    <PostActions
                      slug={item.id}
                      collections={item.data.collections ?? []}
                      hiddenFromLatest={item.data.hiddenFromLatest}
                      draft={item.data.draft}
                      featured={item.data.featured}
                      pinned={item.data.pinned}
                    />
                  </PostEntry>
                ))}
              </section>
            </div>
          ))
        }
      </div>
    </section>
  </main>
</PageLayout>

<script>
  import '@/scripts/feed-typography';
</script>
