---
import { getCollection } from 'astro:content';
import i18next from '@/i18n';
import Search from '@/components/search';
import PageLayout from '@/components/layouts/PageLayout.astro';
import slateConfig from '~@/slate.config';

const postCollection = await getCollection('post', ({ data }) => {
  return import.meta.env.DEV || data.draft !== true;
});

const tagCounts = postCollection.reduce<Record<string, number>>(
  (res, post) => {
    const postTags = post.data.tags;
    if (!postTags || !postTags.length) return res;
    postTags.forEach((tag) => {
      if (tag.trim() === '') return;

      if (res[tag]) {
        res[tag]++;
      } else {
        res[tag] = 1;
      }
    });
    return res;
  },
  {
    [i18next.t('common.all')]: postCollection.length,
  },
);

const tags = Object.keys(tagCounts).map((tag) => ({
  name: tag,
  count: tagCounts[tag],
}));

const posts = [...postCollection]
  .sort(
    (a, b) =>
      (b.data.pubDate?.getTime() ?? 0) - (a.data.pubDate?.getTime() ?? 0),
  )
  .map((post) => ({
    id: post.id,
    url: `/blog/${post.id}`,
    data: post.data,
  }));
---

<style>
  .navi > span:last-child {
    display: none;
  }

  .home-tag {
    border: 0;
    background: var(--color-slate3);
    color: var(--color-slate10);
  }

  .home-tag:hover {
    background: var(--color-slate4);
    color: var(--color-slate11);
  }

  .home-tag[aria-pressed='true'] {
    background: var(--color-slate12);
    color: var(--color-slate1);
  }
</style>

<PageLayout>
  <section class="relative mb-16">
    <h3 class="text-slate12 text-[40px] leading-tight font-semibold">
      {slateConfig.title}
    </h3>
    <p class="text-slate10 text-xl">{slateConfig.description}</p>
    <div class="navi mt-5 flex flex-wrap gap-3 text-base">
      {
        slateConfig.navigations?.map((navigation) => {
          return (
            <>
              <a href={navigation.href} class="flex items-center">
                {navigation.label}
              </a>
              <span>·</span>
            </>
          );
        })
      }
    </div>
    <Search
      client:only="react"
      className="absolute top-1/2 right-0 -translate-y-1/2"
    />
  </section>

  <section id="post-list-section" class="mb-16 scroll-mt-8">
    <div id="post-list" class="text-slate12 text-base" aria-live="polite">
      {
        posts.map((item) => (
          <a
            data-post-item
            data-tags={JSON.stringify(item.data.tags ?? [])}
            class="active:bg-slate4 sm:hover:bg-slate3 flex cursor-pointer flex-col justify-between rounded-lg py-2.5 transition-all active:scale-[0.995] sm:flex-row sm:items-center sm:px-2"
            href={item.url}
            title={item.data.title}
          >
            <span class="shrink-0">{item.data.title}</span>
            <span class="border-slate6 mx-8 hidden h-px w-full grow border-t border-dashed sm:flex" />
            <span class="text-slate8 shrink-0">
              {item.data.pubDate?.toLocaleDateString('zh-CN', {
                year: '2-digit',
                month: '2-digit',
                day: '2-digit',
              })}
            </span>
          </a>
        ))
      }
      <p id="post-filter-empty" class="text-slate10 py-8 text-center" hidden>
        这个标签下还没有文章。
      </p>
    </div>
  </section>

  <!-- S 标签 -->
  <section class="mb-16">
    <ul class="text-slate10 flex flex-wrap gap-2 text-base">
      {
        tags.map(({ name, count }, index) => (
          <li>
            <button
              type="button"
              class="home-tag cursor-pointer rounded-full px-4 py-2 transition-all active:scale-[0.98]"
              data-tag={name}
              aria-pressed={index === 0 ? 'true' : 'false'}
            >
              {name}
              <sup class="text-slate8 ml-1 text-[9px]">{count}</sup>
            </button>
          </li>
        ))
      }
    </ul>
    <span id="post-filter-status" class="sr-only" aria-live="polite"></span>
  </section>
  <!-- E 标签 -->
</PageLayout>

<script>
  const allTag = document.querySelector<HTMLButtonElement>(
    '.home-tag[aria-pressed="true"]',
  )?.dataset.tag;
  const tagButtons = document.querySelectorAll<HTMLButtonElement>('.home-tag');
  const postItems = document.querySelectorAll<HTMLElement>('[data-post-item]');
  const emptyState = document.querySelector<HTMLElement>('#post-filter-empty');
  const filterStatus = document.querySelector<HTMLElement>(
    '#post-filter-status',
  );
  const postListSection =
    document.querySelector<HTMLElement>('#post-list-section');

  tagButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const selectedTag = button.dataset.tag;
      let visibleCount = 0;

      tagButtons.forEach((item) => {
        item.setAttribute('aria-pressed', String(item === button));
      });

      postItems.forEach((item) => {
        const tags = JSON.parse(item.dataset.tags || '[]') as string[];
        const isVisible = selectedTag === allTag || tags.includes(selectedTag!);
        item.hidden = !isVisible;
        if (isVisible) visibleCount += 1;
      });

      if (emptyState) emptyState.hidden = visibleCount > 0;
      if (filterStatus)
        filterStatus.textContent = `${selectedTag}：${visibleCount} 篇文章`;
      postListSection?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });
</script>
