---
import dayjs from 'dayjs';
import { type CollectionEntry, getCollection, render } from 'astro:content';
import i18next from '@/i18n';
import PageLayout from '@/components/layouts/PageLayout.astro';
import ArticleJsonLd from '@/components/json-ld/article.astro';
import Button from '@/components/button';
import AffixTitle from '@/components/affix-title';
import RelatedPosts from '@/components/related-posts/index.astro';
import Toc from '@/components/toc';
import CodeGroupEvent from '@/components/code-group-event';
import slateConfig from '~@/slate.config';
import { getFullTitle } from '@/helpers/utils';
import 'remark-block-containers/css';
import 'heti/umd/heti.min.css';
import '@/assets/style/blog.css';

export async function getStaticPaths() {
  const postEntries = await getCollection('post', ({ data }) => {
    return import.meta.env.DEV || data.draft !== true;
  });

  return postEntries.map((post) => {
    const postTags = new Set(post.data.tags ?? []);
    const candidates = postEntries
      .filter(
        (candidate) =>
          candidate.id !== post.id && candidate.data.draft !== true,
      )
      .map((candidate) => ({
        candidate,
        score: (candidate.data.tags ?? []).filter((tag) => postTags.has(tag))
          .length,
      }))
      .sort(
        (a, b) =>
          b.score - a.score ||
          (b.candidate.data.pubDate?.getTime() ?? 0) -
            (a.candidate.data.pubDate?.getTime() ?? 0),
      );
    const relatedPosts = candidates
      .filter(({ score }) => score > 0)
      .slice(0, 3)
      .map(({ candidate }) => ({
        title: candidate.data.title,
        slug: candidate.id,
        description: candidate.data.description,
        pubDate: candidate.data.pubDate,
        tags: candidate.data.tags ?? [],
      }));

    const visibleRelatedPosts = relatedPosts.length > 1 ? relatedPosts : [];

    return {
      params: { slug: post.id },
      props: { post, relatedPosts: visibleRelatedPosts },
    };
  });
}

interface RelatedPost {
  title: string;
  slug: string;
  description?: string;
  pubDate?: Date;
  tags: string[];
}

interface Props {
  post: CollectionEntry<'post'>;
  relatedPosts: RelatedPost[];
}

const { post, relatedPosts } = Astro.props;
const { Content, remarkPluginFrontmatter, headings } = await render(post);
const lastModifiedDate = dayjs(
  remarkPluginFrontmatter.lastModified
    ? remarkPluginFrontmatter.lastModified
    : undefined,
);
const lastModified = lastModifiedDate.isSame(dayjs(), 'year')
  ? lastModifiedDate.format('MM/DD')
  : lastModifiedDate.format('YY/MM/DD');
const pubDate = dayjs(post.data.pubDate);
const formattedPubDate = pubDate.isSame(dayjs(), 'year')
  ? pubDate.format('MM/DD')
  : pubDate.format('YY/MM/DD');
---

<PageLayout title={post.data.title} description={post.data.description}>
  <ArticleJsonLd
    slot="json-ld"
    title={getFullTitle(post.data.title)}
    description={post.data.description}
    pubDate={post.data.pubDate}
    lastModified={lastModifiedDate.toDate()}
  />
  <CodeGroupEvent client:only="react" />
  <AffixTitle title={post.data.title} offsetTop={100} client:idle />

  <div class="mb-16" slot="header">
    <Button id="back">←</Button>
  </div>

  <div class="blog-content">
    <div class="mb-16">
      <h1>{post.data.title}</h1>
      <div class="text-slate10 flex items-center gap-2">
        <span>{formattedPubDate}</span>
        {!!slateConfig.readTime && <span>·</span>}
        {
          slateConfig.readTime && (
            <div>
              {i18next.t('blog.readingTime', {
                minutes: remarkPluginFrontmatter.minutesRead,
              })}
            </div>
          )
        }
      </div>
    </div>
    <div class="post-content heti">
      <Content />
      {
        slateConfig.lastModified && (
          <div class="text-slate8" style="font-size: 14px;">
            {i18next.t('blog.lastModified')} {lastModified}
          </div>
        )
      }
    </div>
    <RelatedPosts posts={relatedPosts} />
  </div>
  <!-- E 内容 -->
  <!-- S 目录 -->
  <Toc
    className="fixed top-0 right-0 bottom-0 hidden w-64 xl:block"
    listClassName="px-5 pt-44 pb-14 "
    dataSource={headings}
    client:visible
  />
  <!-- E 目录 -->
</PageLayout>

<script src="//cdn.jsdmirror.com/npm/heti/umd/heti-addon.min.js" is:inline
></script>
<script>
  const backBtn = document.getElementById('back');
  backBtn?.addEventListener('click', () => {
    window.location.href = '/';
  });

  const heti = new Heti('.blog-content');
  heti.autoSpacing();
</script>
