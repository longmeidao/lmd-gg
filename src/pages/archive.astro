---
import { render } from 'astro:content';
import PageLayout from '@/components/layouts/PageLayout.astro';
import BackHeader from '@/components/layouts/BackHeader.astro';
import PostActions from '@/components/admin/PostActions.astro';
import ThreadGroup from '@/components/feed/ThreadGroup.astro';
import ThreadCollapse from '@/components/feed/ThreadCollapse.astro';
import {
  getPostDisplayTitle,
  getPostExcerpt,
  getPostPath,
} from '@/helpers/post';
import { getPostCollections } from '@/helpers/collection';
import { buildFilters, detectMedia } from '@/helpers/filters';
import { resizeUrl, THUMB_WIDTH } from '@/helpers/media';
import {
  byPubDateDesc,
  getSitePosts,
  groupPostThreads,
} from '@/helpers/content';
import FilterBar from '@/components/feed/FilterBar.astro';
import '@/assets/style/home.css';
import '@/assets/style/archive.css';

/**
 * 归档：按月分组的方格墙 + 顶部图标胶囊筛选（版式照 jant 的 /archive）。
 * 列表视图直接复用首页的条目展示（jant 那边是 TimelineFeedItem，本站是 PostEntry）。
 * 站点是静态输出，jant 的 URL 参数式服务端筛选换成前端筛选。
 */
const postCollection = await getSitePosts();

/**
 * 正文里的第一张图，用作方格封面。
 *
 * 图片只在 R2 上存原件，尺寸由 Cloudflare 现场转换，所以这里只是把正文那张
 * 的地址换个宽度重新生成 —— 方格才 170px，别用正文的 1200px 那份。
 */
const firstImage = (body: string | undefined) =>
  body?.match(/!\[[^\]]*\]\(\s*([^)\s]+)/)?.[1] ??
  body?.match(/<img[^>]+src=["']([^"']+)/)?.[1] ??
  '';

const coverFor = (body: string | undefined) => {
  const source = firstImage(body);
  return source ? resizeUrl(source, THUMB_WIDTH) : '';
};

const entries = await Promise.all(
  [...postCollection].sort(byPubDateDesc).map(async (post) => {
    const date = post.data.pubDate;
    const { Content } = await render(post);
    return {
      id: post.id,
      url: getPostPath(post.id),
      data: post.data,
      Content,
      kind: post.data.kind,
      title: post.data.title?.trim() ?? '',
      displayTitle: getPostDisplayTitle(post.data),
      summary: getPostExcerpt(post.body, 96) ?? '',
      externalUrl: post.data.externalUrl,
      featured: post.data.featured === true,
      collections: getPostCollections(post.data),
      isThread: Boolean(post.data.thread),
      hasTitle: Boolean(post.data.title?.trim()),
      media: detectMedia(
        post.body,
        post.data.kind,
        post.data.attached === true,
      ),
      cover: coverFor(post.body),
      visibility: post.data.draft
        ? 'private'
        : post.data.hiddenFromLatest
          ? 'hidden'
          : 'public',
      year: date ? date.getFullYear() : 0,
      monthKey: date ? `${date.getFullYear()}-${date.getMonth() + 1}` : '',
      monthLabel: date
        ? `${date.getFullYear()} 年 ${date.getMonth() + 1} 月`
        : '未标日期',
      shortDate: date ? `${date.getMonth() + 1} 月 ${date.getDate()} 日` : '',
      iso: date?.toISOString(),
    };
  }),
);

/** 按月分组，保持整体的时间倒序 */
const filters = buildFilters(entries);

const months: Array<{ key: string; label: string; items: typeof entries }> = [];
entries.forEach((entry) => {
  const last = months.at(-1);
  if (last && last.key === entry.monthKey) last.items.push(entry);
  else
    months.push({
      key: entry.monthKey,
      label: entry.monthLabel,
      items: [entry],
    });
});

/**
 * 列表视图按串文分组，和首页用的是同一个 groupPostThreads —— 不这么做，
 * 同一串的几条会摊成互不相干的独立条目，左边那条锚点轨道根本画不出来。
 * 方格视图不分组：那是一格一条的墙，串起来没有意义。
 */
const listGroups = groupPostThreads(entries);
---

<PageLayout title="档案室" description="按月份排列的全部内容。">
  <BackHeader slot="header" />

  <main id="main-content" tabindex="-1" class="archive-page">
    <header class="archive-page-header">
      <h1 class="archive-page-title">档案室</h1>
      <FilterBar filters={filters} count={entries.length} feedHref="/rss.xml">
        <div
          class="archive-view-toggle"
          role="group"
          aria-label="切换视图"
          slot="trailing"
        >
          <button
            type="button"
            class="archive-view-btn is-active"
            data-archive-view="grid"
            aria-pressed="true"
            aria-label="方格视图"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect width="7" height="7" x="3" y="3" rx="1"></rect>
              <rect width="7" height="7" x="14" y="3" rx="1"></rect>
              <rect width="7" height="7" x="14" y="14" rx="1"></rect>
              <rect width="7" height="7" x="3" y="14" rx="1"></rect>
            </svg>
          </button>
          <button
            type="button"
            class="archive-view-btn"
            data-archive-view="list"
            aria-pressed="false"
            aria-label="列表视图"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M3 5h.01"></path>
              <path d="M3 12h.01"></path>
              <path d="M3 19h.01"></path>
              <path d="M8 5h13"></path>
              <path d="M8 12h13"></path>
              <path d="M8 19h13"></path>
            </svg>
          </button>
        </div>
      </FilterBar>
    </header>

    <div
      class="archive-body"
      data-archive-body
      data-view="grid"
      data-drafts-endpoint={import.meta.env.DEV
        ? '/__lmd/write?view=drafts'
        : '/api/admin/posts?view=drafts'}
    >
      {/* 方格视图 */}
      <div class="archive-grid" data-archive-grid>
        {
          months.map((month) => (
            <>
              <div class="archive-month-header" data-month-header={month.key}>
                <span class="archive-month-header-label">{month.label}</span>
                <span class="archive-month-header-count">
                  <span data-month-count={month.key}>{month.items.length}</span>{' '}
                  条
                </span>
              </div>
              {month.items.map((entry) => (
                <a
                  class:list={[
                    'archive-tile',
                    /* dev 会把草稿一起构建进来（showDraftsAtBuild），生产则由脚本
                       注入并带上这个类。两边都标上，草稿的虚线框才一致。 */
                    entry.visibility === 'private' && 'archive-draft-tile',
                  ]}
                  href={entry.url}
                  data-archive-item
                  data-slug={entry.id}
                  data-month={month.key}
                  data-year={entry.year}
                  data-kind={entry.kind}
                  data-collections={JSON.stringify(entry.collections)}
                  data-thread={String(entry.isThread)}
                  data-has-title={String(entry.hasTitle)}
                  data-media={entry.media.join(',')}
                  data-visibility={entry.visibility}
                  data-featured={String(entry.featured)}
                >
                  <div class="archive-tile-top-meta">
                    <time class="archive-tile-date" datetime={entry.iso}>
                      {entry.shortDate}
                    </time>
                    {entry.featured && (
                      <span class="archive-tile-badge">
                        <span class="sr-only">精选辑</span>
                        <svg
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.6"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                        >
                          <path d="M12 3 10.1 10.1 3 12l7.1 1.9L12 21l1.9-7.1L21 12l-7.1-1.9Z" />
                        </svg>
                      </span>
                    )}
                  </div>
                  {entry.cover && (
                    <img
                      class="archive-tile-cover"
                      src={entry.cover}
                      alt=""
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                  <div
                    class:list={[
                      'archive-tile-content',
                      entry.cover && 'has-cover',
                    ]}
                  >
                    {entry.kind === 'quote' && (
                      <span class="archive-tile-quote-mark" aria-hidden="true">
                        <svg viewBox="0 0 96 96" aria-hidden="true">
                          <path
                            fill="currentColor"
                            d="M24.4 10.5C16.9 17.7 11.5 26.8 8.2 37.7C4.9 48.7 4.8 58.9 7.8 68.2C10.3 75.7 15.4 79.5 22.9 79.5C28 79.5 32.2 77.8 35.4 74.2C38.6 70.7 40.2 66.5 40.2 61.4C40.2 56.5 38.8 52.6 36 49.6C33.3 46.6 29.7 45.1 25.2 45.1C23.4 45.1 21.8 45.3 20.2 45.8C22.2 37.3 26.7 29.2 33.6 21.4L24.4 10.5Z"
                          />
                          <path
                            fill="currentColor"
                            d="M60.8 10.5C53.3 17.7 47.9 26.8 44.6 37.7C41.3 48.7 41.2 58.9 44.2 68.2C46.7 75.7 51.8 79.5 59.3 79.5C64.4 79.5 68.6 77.8 71.8 74.2C75 70.7 76.6 66.5 76.6 61.4C76.6 56.5 75.2 52.6 72.4 49.6C69.7 46.6 66.1 45.1 61.6 45.1C59.8 45.1 58.2 45.3 56.6 45.8C58.6 37.3 63.1 29.2 70 21.4L60.8 10.5Z"
                          />
                        </svg>
                      </span>
                    )}
                    <div class="archive-tile-copy">
                      {entry.title && (
                        <span class="archive-tile-title">
                          {entry.title}
                          {entry.externalUrl && (
                            <span
                              class="archive-tile-link-indicator"
                              aria-hidden="true"
                            >
                              <svg
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                              >
                                <path d="M14 5h5v5M19 5l-9 9" />
                              </svg>
                            </span>
                          )}
                        </span>
                      )}
                      <span class="archive-tile-summary">
                        {entry.summary || entry.displayTitle}
                      </span>
                    </div>
                  </div>
                </a>
              ))}
            </>
          ))
        }
      </div>

      {/* 列表视图：和首页一样的条目展示 */}
      <div class="archive-list home-feed" data-archive-list>
        {
          listGroups.map((group, groupIndex) => (
            <div class="home-feed-cluster" data-feed-cluster>
              {groupIndex > 0 && (
                <div class="home-group-divider" aria-hidden="true" />
              )}
              <ThreadGroup
                items={group.items}
                thread={group.thread}
                itemAttrs={group.items.map((entry) => ({
                  'data-archive-item': '',
                  'data-slug': entry.id,
                  'data-month': entry.monthKey,
                  'data-year': String(entry.year),
                  'data-thread': String(entry.isThread),
                  'data-has-title': String(entry.hasTitle),
                  'data-media': entry.media.join(','),
                  'data-visibility': entry.visibility,
                  'data-featured': String(entry.featured),
                }))}
              />
            </div>
          ))
        }
      </div>

      {
        /*
        草稿是登录后由脚本注入的，拿不到 Astro 组件，所以在这里放一份模板，
        scripts/archive.ts 克隆它再改 slug 和几个状态属性 —— 免得把
        PostActions 那一大段 markup 在 JS 里重抄一遍。
        <template> 的内容不进文档树，也不会被 revealAdmin 扫到。
      */
      }
      <template data-post-actions-template>
        <PostActions slug="" />
      </template>

      {/* 同理：注入的草稿如果串成一串，前面几条也要能折叠 */}
      <template data-thread-collapse-template>
        <ThreadCollapse position="before" count={0} />
      </template>

      {/* 空状态是筛选筛出来的，得给条回去的路，不然只能逐个胶囊点回全部 */}
      <div class="archive-empty" data-archive-empty hidden>
        <p>没有符合条件的内容。</p>
        <button
          type="button"
          class="archive-clear-filters"
          data-archive-clear-filters
        >
          清除筛选
        </button>
      </div>
    </div>
  </main>
</PageLayout>

<script>
  import '@/scripts/feed-typography';
  import '@/scripts/archive';
</script>
