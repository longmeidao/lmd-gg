---
import PageLayout from '@/components/layouts/PageLayout.astro';
import Button from '@/components/button';
import '@/assets/style/blog.css';
import 'bangumi-tv/dist/bangumi.css';
import 'remark-block-containers/css';
---

<PageLayout title="导览册">
  <style is:global>
    .bgm-categories,
    .bgm-tabs {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.5rem;
      color: var(--color-slate10);
    }
    .bgm-categories {
      gap: 0.625rem;
      margin-bottom: 1rem;
    }
    .bgm-category,
    .bgm-tab {
      appearance: none;
      border: 0;
      border-radius: 9999px;
      padding: 0.5rem 1rem;
      background: var(--color-slate3);
      color: var(--color-slate10);
      font: inherit;
      line-height: 1.25;
      cursor: pointer;
      transition:
        background-color 150ms ease,
        color 150ms ease,
        transform 150ms ease;
    }
    .bgm-category {
      font-weight: 500;
    }
    .bgm-tab {
      padding: 0.375rem 0.75rem;
      background: var(--color-slate2);
      color: var(--color-slate9);
      font-size: var(--text-sm);
    }
    .bgm-category:hover,
    .bgm-tab:hover {
      background: var(--color-slate4);
      color: var(--color-slate11);
    }
    .bgm-category:active,
    .bgm-tab:active {
      transform: scale(0.98);
    }
    .bgm-category:focus-visible,
    .bgm-tab:focus-visible,
    .bgm-btn:focus-visible {
      outline: 2px solid var(--color-slate9);
      outline-offset: 2px;
    }
    .bgm-tabs {
      gap: 0.375rem;
      margin: 0 0 2.25rem;
    }
    .bgm-category-active {
      background: var(--color-slate12);
      color: var(--color-slate1);
    }
    .bgm-active {
      background: var(--color-slate11);
      color: var(--color-slate1);
    }
    .bgm-filter-count {
      display: inline-block;
      margin-left: 0.2rem;
      color: var(--color-slate8);
      font-size: 0.5rem;
      font-weight: 400;
      line-height: 1;
      vertical-align: super;
      transform: translateY(0.05rem);
    }
    .bgm-item {
      background-color: var(--block-info-bg);
      border-radius: 0.5rem;
      overflow: hidden;
    }
    .bgm-item-thumb {
      border-radius: 0.5rem 0.5rem 0 0;
    }
    .bgm-item-info {
      padding: 0.75rem;
    }
    .bgm-item-title.main {
      font-size: var(--text-sm);
      color: var(--color-slate12);
      margin-bottom: 5px;
      font-weight: bold;
    }
    .bgm-item-title:not(.main) {
      display: none;
    }
    .bgm-item-statusBar {
      background: var(--color-slate8);
    }
    .bgm-item-statusBar-container {
      background: var(--color-slate11);
    }
    .bgm-item-meta {
      width: 100%;
      border-radius: 1rem;
      padding: 0.2rem 0.5rem;
      background: var(--color-slate3);
      color: var(--color-slate11);
      font-size: var(--text-xs);
    }
    .bgm-state {
      display: flex;
      width: 100%;
      min-height: 9rem;
      align-items: center;
      justify-content: center;
      flex-direction: column;
      gap: 0.75rem;
      color: var(--color-slate11);
      text-align: center;
    }
    .post-content .bgm-loading-image {
      display: block;
      width: 15%;
      min-width: 4rem;
      max-width: 7rem;
      margin: 0;
      border: 0;
      border-radius: 0;
      outline: 0;
      box-shadow: none;
    }
    .bgm-navigator {
      text-align: center;
    }
    .bgm-btn {
      margin-top: 24px;
      border: 0;
      border-radius: 1.375rem;
      padding: 0 1.25rem;
      min-width: 5rem;
      height: 2.25rem;
      background-color: var(--color-slate3) !important;
      color: var(--color-slate11) !important;
      font: inherit;
      line-height: 2.25rem;
      text-decoration: none !important;
      cursor: pointer;
    }
    .bgm-btn:hover {
      background-color: var(--color-slate4) !important;
      color: var(--color-slate12) !important;
    }
    .bgm-retry {
      margin-top: 0;
    }
    @media screen and (max-width: 450px) {
      .bgm-category {
        padding: 0.45rem 0.8rem;
        font-size: var(--text-sm);
      }
      .bgm-tab {
        padding: 0.3rem 0.65rem;
        font-size: var(--text-xs);
      }
    }
  </style>
  <div class="mb-16" slot="header">
    <Button id="back">←</Button>
  </div>
  <div class="blog-content">
    <div class="mb-16">
      <h1>导览册</h1>
    </div>
    <div class="post-content">
      <img
        src="/images/rin.png"
        alt="Avatar"
        style="width: calc(var(--spacing)* 28); height: calc(var(--spacing)* 28); border-radius: 3.40282e38px; border-style: var(--tw-border-style); border-width: 4px; border-color: var(--color-white);"
      />
      <h3 style="text-align: center;">泷美道</h3>
      <div
        style="display: flex; gap: calc(var(--spacing)* 3); align-items: center; justify-content: center;"
      >
        <del><a href="https://bento.me/lmd">Bento</a></del>
        <span>·</span>
        <a href="mailto:i@lmd.gg">寄信</a>
      </div>
      <hr />
      <h3 style="text-align: center;">番组计划</h3>
      <div class="bgm-container"></div>
    </div>
  </div>

  <style></style>
  <script>
    const backBtn = document.getElementById('back');
    backBtn?.addEventListener('click', () => {
      window.location.href = '/';
    });
  </script>
  <script is:inline>
    window.bgmConfig = {
      apiUrl: 'https://api.bgm.tv',
      username: 'longmeidao',
    };
  </script>
  <script is:inline src="/scripts/bangumi.js"></script>
</PageLayout>
