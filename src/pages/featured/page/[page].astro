---
import FeaturedView from '@/components/feed/FeaturedView.astro';
import { getFeaturedPostGroups } from '@/helpers/content';
import { getPageCount, getPageSize } from '@/helpers/pagination';

export async function getStaticPaths() {
  const pageSize = getPageSize();
  const totalPages = getPageCount(
    (await getFeaturedPostGroups()).length,
    pageSize,
  );
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => {
    const page = index + 2;
    return { params: { page: String(page) }, props: { page } };
  });
}

const { page } = Astro.props;
---

<FeaturedView page={page} />
