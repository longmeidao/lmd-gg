---
import HomeView from '@/components/feed/HomeView.astro';
import { getLatestPostGroups } from '@/helpers/content';
import { getPageCount } from '@/helpers/pagination';
import slateConfig from '~@/slate.config';

export async function getStaticPaths() {
  const pageSize = slateConfig.pagination?.pageSize ?? 20;
  const totalPages = getPageCount(
    (await getLatestPostGroups()).length,
    pageSize,
  );
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => {
    const page = index + 2;
    return { params: { page: String(page) }, props: { page } };
  });
}

const { page } = Astro.props;
---

<HomeView page={page} />
