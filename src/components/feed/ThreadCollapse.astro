---
/**
 * 带渐隐预览和展开按钮的串文折叠段。
 * before 与 after 通过 CSS 调整顺序，确保按钮靠近当前内容。
 */
interface Props {
  /** 相对当前内容的位置。 */
  position: 'before' | 'after';
  /** 折叠条数。 */
  count: number;
}

const { position, count } = Astro.props;
---

<div class="thread-collapse" data-thread-collapse data-position={position}>
  <div class="thread-collapse-shell" data-thread-shell data-collapsed>
    <slot />
  </div>
  <button
    type="button"
    class="thread-collapse-toggle"
    data-thread-toggle
    data-count={count}
    aria-expanded="false"
  >
    <span data-thread-toggle-label>显示其余 {count} 条</span>
    {/* 通过切换路径改变箭头方向，避免 SVG 过渡中的旋转异常。 */}
    <span class="thread-collapse-chevron" aria-hidden="true">
      <svg viewBox="0 0 16 16">
        <path
          data-thread-toggle-chevron
          d="M4 6l4 4 4-4"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </span>
  </button>
</div>
