---
/**
 * 串文里被折叠的那一段：一截带渐隐的预览 + 一个展开按钮。
 * 做法参考 owenyoung.com 的 .thread-context-shell（max-height + mask 渐隐）。
 * 和它不同的地方：owen 只折当前条前面的内容、后面的永远全展开，
 * 看到串文中间那条时下方会拖一长串收不起来——这里把位置做成参数，
 * 当前条的上下各放一个。
 *
 * 按钮永远紧挨着当前那条，所以两个方向顺序相反（before：壳在上、按钮在下；
 * after 反过来），交给 CSS 的 column-reverse，slot 只需渲染一次。
 */
interface Props {
  /** 折叠段相对当前内容的位置 */
  position: 'before' | 'after';
  /** 折叠了多少条，用于按钮文案 */
  count: number;
}

const { position, count } = Astro.props;
---

<div class="thread-collapse" data-thread-collapse data-position={position}>
  <div class="thread-collapse-shell" data-thread-shell data-collapsed>
    <slot />
  </div>
  <button
    type="button"
    class="thread-collapse-toggle"
    data-thread-toggle
    data-count={count}
    aria-expanded="false"
  >
    <span data-thread-toggle-label>显示其余 {count} 条</span>
    {
      /* 三角形状同 owen 的 .thread-context-toggle-chevron。
        折叠时朝下、展开后朝上，由脚本换 path 的 d——CSS rotate 试过，
        SVG 上带 transition 时会停在单位矩阵转不动，换路径最稳。 */
    }
    <span class="thread-collapse-chevron" aria-hidden="true">
      <svg viewBox="0 0 16 16">
        <path
          data-thread-toggle-chevron
          d="M4 6l4 4 4-4"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </span>
  </button>
</div>
