---
import type { CollectionEntry } from 'astro:content';
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import PostEntry from '@/components/feed/PostEntry.astro';
import PostActions from '@/components/admin/PostActions.astro';
import ThreadCollapse from '@/components/feed/ThreadCollapse.astro';
import { THREAD_COLLAPSE_FROM } from '@/helpers/threads';

/** 渲染单条内容或一组串文；串文详情页由 PostView.astro 单独处理。 */
export interface FeedItem {
  id: string;
  url: string;
  data: CollectionEntry<'post'>['data'];
  Content: AstroComponentFactory;
}

interface Props {
  items: FeedItem[];
  /** 串文键名；存在时显示锚点轨道。 */
  thread?: string;
  ariaLabel?: string;
  /** 是否显示置顶标记。 */
  showPinned?: boolean;
  /** 是否隐藏页脚中的合集。 */
  hideCollections?: boolean;
  /** 与 items 按索引对应的条目属性，供前端筛选使用。 */
  itemAttrs?: Array<Record<string, string>>;
  /** 是否添加首页分组标记。 */
  feedGroup?: boolean;
}

const {
  items,
  thread,
  ariaLabel,
  showPinned = false,
  hideCollections = false,
  itemAttrs,
  feedGroup = false,
} = Astro.props;

/** 串文仅展开最新内容；达到阈值时折叠前文。 */
const context = thread ? items.slice(0, -1) : [];
const collapsed = context.length >= THREAD_COLLAPSE_FROM;
const shown = collapsed ? items.slice(-1) : items;
const shownOffset = collapsed ? items.length - 1 : 0;
---

<section
  class="home-feed-group"
  data-feed-group={feedGroup ? true : undefined}
  data-thread-group={thread}
  data-visible-count={items.length}
  aria-label={ariaLabel}
>
  {
    collapsed && (
      <ThreadCollapse position="before" count={context.length}>
        {context.map((item, index) => (
          <PostEntry
            item={item}
            isFirst={index === 0}
            showPinned={showPinned}
            hideCollections={hideCollections}
            itemAttrs={itemAttrs?.[index]}
          >
            <PostActions
              slug={item.id}
              collections={item.data.collections ?? []}
              hiddenFromLatest={item.data.hiddenFromLatest}
              draft={item.data.draft}
              featured={item.data.featured}
              pinned={item.data.pinned}
            />
          </PostEntry>
        ))}
      </ThreadCollapse>
    )
  }

  {
    shown.map((item, index) => (
      <PostEntry
        item={item}
        isFirst={shownOffset + index === 0}
        isLast={shownOffset + index === items.length - 1}
        isThreadLatest={!!thread && shownOffset + index === items.length - 1}
        showPinned={showPinned}
        hideCollections={hideCollections}
        itemAttrs={itemAttrs?.[shownOffset + index]}
      >
        <PostActions
          slug={item.id}
          collections={item.data.collections ?? []}
          hiddenFromLatest={item.data.hiddenFromLatest}
          draft={item.data.draft}
          featured={item.data.featured}
          pinned={item.data.pinned}
        />
      </PostEntry>
    ))
  }
</section>
