---
import dayjs from 'dayjs';
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import i18next from '@/i18n';
import PageLayout from '@/components/layouts/PageLayout.astro';
import BackHeader from '@/components/layouts/BackHeader.astro';
import ArticleJsonLd from '@/components/json-ld/article.astro';
import RelatedPosts from '@/components/related-posts/index.astro';
import PostActions from '@/components/admin/PostActions.astro';
import CodeGroupEvent from '@/components/code-group-event';
import PostEntry from '@/components/feed/PostEntry.astro';
import ThreadCollapse from '@/components/feed/ThreadCollapse.astro';
import slateConfig from '~@/slate.config';
import { getFullTitle } from '@/helpers/utils';
import {
  getPostDisplayTitle,
  getPostExcerpt,
  type PostKind,
} from '@/helpers/post';
import { getSitePosts, renderFeedPosts } from '@/helpers/content';
import 'remark-block-containers/css';
import 'heti/umd/heti.min.css';
import '@/assets/style/blog.css';
import '@/assets/style/home.css';

interface RelatedPost {
  title: string;
  id: string;
  kind: PostKind;
  description?: string;
  pubDate?: Date;
  collections: string[];
}

interface Props {
  post: CollectionEntry<'post'>;
  relatedPosts: RelatedPost[];
}

const { post, relatedPosts } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(post);
const hasTitle = Boolean(post.data.title?.trim());
// 页面标题、og、JSON-LD 仍然需要一个名字，所以这里保留兜底；
// 但正文里只有 hasTitle 为真时才渲染 h1。
const postTitle = getPostDisplayTitle(post.data);
const postDescription = getPostExcerpt(post.body);
const lastModifiedDate = dayjs(
  remarkPluginFrontmatter.lastModified
    ? remarkPluginFrontmatter.lastModified
    : undefined,
);
const lastModified = lastModifiedDate.format('YYYY年M月D日');
const pubDate = dayjs(post.data.pubDate);
const formattedPubDate = pubDate.format('YYYY年M月D日');
/** 只有一张图的随记算出来是 0 分钟，那行字没有意义 */
const showReadTime =
  Boolean(slateConfig.readTime) && remarkPluginFrontmatter.minutesRead > 0;

/**
 * 「编辑于」只在真的改过正文、且确实晚于发布日期时才显示。
 *
 * pubDate 是发布时写进 frontmatter 的本地日期，定死不变；而 remark-modified-time
 * 读的是 git 提交时间戳，按构建机器的时区格式化。CI 的 runner 是 UTC，跨时区就会
 * 把同一时刻渲染成前一天，显示成「2026年8月1日 · 编辑于 2026年7月31日」。
 *
 * 根治办法是在工作流里把 TZ 钉成 Asia/Shanghai（见 .github/workflows/deploy.yml）。
 * 这里的「严格晚于」是兜底：万一哪天又有别的时区来源，也不会显示出倒流的日期。
 */
const showLastModified =
  Boolean(slateConfig.lastModified) &&
  lastModifiedDate.startOf('day').isAfter(pubDate.startOf('day'));

/**
 * 串文里的任意一条被点开时，整串都要展示出来，左侧锚点高亮当前这条。
 * 点开的正好是最新一条时，把之前的压暗，突出最新的（参考 owenyoung.com 的串文页）。
 */
const threadId = post.data.thread;
const threadEntries = threadId
  ? await renderFeedPosts(
      (await getSitePosts(({ data }) => data.thread === threadId)).sort(
        (a, b) =>
          (a.data.pubDate?.getTime() ?? 0) - (b.data.pubDate?.getTime() ?? 0),
      ),
    )
  : [];

const isThread = threadEntries.length > 1;
const currentIndex = threadEntries.findIndex((entry) => entry.id === post.id);
const isLatestInThread = isThread && currentIndex === threadEntries.length - 1;

/*
 * 当前这条之外的内容折叠起来，上下各一段。
 *
 * owen 只折叠前面的，后面的永远全展开 —— 看串文中间那条时，下方会拖着一长串
 * 收不起来。这里把「之后」也折上，当前那条正好被夹在两个按钮中间。
 */
const threadBefore = isThread ? threadEntries.slice(0, currentIndex) : [];
const threadAfter = isThread ? threadEntries.slice(currentIndex + 1) : [];

/** 只折 1 条不值得——按钮占的地方跟内容差不多，还多一次点击。2 条起才折。 */
const COLLAPSE_FROM = 2;
const collapseBefore = threadBefore.length >= COLLAPSE_FROM;
const collapseAfter = threadAfter.length >= COLLAPSE_FROM;
---

<PageLayout title={postTitle} description={postDescription}>
  <ArticleJsonLd
    slot="json-ld"
    title={getFullTitle(postTitle)}
    description={postDescription}
    pubDate={post.data.pubDate}
    lastModified={lastModifiedDate.toDate()}
  />
  <CodeGroupEvent client:only="react" />

  <BackHeader slot="header" />

  {
    /* 正文要有 <main> 地标：读屏用户靠它一步跳到内容，否则只能从页头一路 Tab 下来。
      串文视图和正文都算内容，一起包进来。 */
  }
  <main id="main-content" tabindex="-1">
    {
      /* 串文视图必须放在 .blog-content 外面：blog.css 的正文样式（a / blockquote
       那些）会套到 feed 的结构性元素上 —— 引文卡片被再包一层引用边框、日期和
       合集链接变成蓝色带下划线、下划线还铺满整行。挪出来就一次性都干净了。 */
      isThread && (
        <section
          class="thread-view home-column"
          data-thread-view
          data-emphasise-latest={isLatestInThread ? 'true' : 'false'}
          aria-label={`这条串文共 ${threadEntries.length} 条内容`}
        >
          <div class="home-feed">
            <div class="home-feed-cluster">
              <section
                class="home-feed-group"
                data-thread-group={threadId}
                data-visible-count={threadEntries.length}
              >
                {collapseBefore && (
                  <ThreadCollapse position="before" count={threadBefore.length}>
                    {threadBefore.map((entry, index) => (
                      <PostEntry
                        item={entry}
                        isFirst={index === 0}
                        isDimmed={isLatestInThread}
                      />
                    ))}
                  </ThreadCollapse>
                )}

                {!collapseBefore &&
                  threadBefore.map((entry, index) => (
                    <PostEntry
                      item={entry}
                      isFirst={index === 0}
                      isDimmed={isLatestInThread}
                    />
                  ))}

                {/* 串文页原来整页都没有操作菜单：下面那条信息栏被 !isThread
                    挡掉了，串文里的条目也没传过 PostActions。给当前这条补上。 */}
                <PostEntry
                  item={threadEntries[currentIndex]!}
                  isFirst={currentIndex === 0}
                  isLast={currentIndex === threadEntries.length - 1}
                  isThreadCurrent
                >
                  <PostActions
                    slug={post.id}
                    collections={post.data.collections ?? []}
                    hiddenFromLatest={post.data.hiddenFromLatest}
                    draft={post.data.draft}
                    featured={post.data.featured}
                    pinned={post.data.pinned}
                  />
                </PostEntry>

                {collapseAfter && (
                  <ThreadCollapse position="after" count={threadAfter.length}>
                    {threadAfter.map((entry, index) => (
                      <PostEntry
                        item={entry}
                        isLast={index === threadAfter.length - 1}
                      />
                    ))}
                  </ThreadCollapse>
                )}

                {!collapseAfter &&
                  threadAfter.map((entry, index) => (
                    <PostEntry
                      item={entry}
                      isLast={index === threadAfter.length - 1}
                    />
                  ))}
              </section>
            </div>
          </div>
        </section>
      )
    }

    <div class="blog-content">
      {
        /* 无标题的内容不造标题、也不在上面挂日期 —— 那一行对一条随记来说太重了。
         日期和操作统一放到正文下面的信息栏（同 owen 的 /18oun）。 */
        hasTitle && (
          <div class:list={['post-header', 'mb-16', isThread && 'sr-only']}>
            <h1>{postTitle}</h1>
            <div class="post-header-meta text-slate10 flex items-center gap-2">
              <span>{formattedPubDate}</span>
              {post.data.rating && (
                <>
                  <span class="heti-skip">·</span>
                  <span>
                    <span aria-hidden="true">
                      {'★'.repeat(post.data.rating)}
                      {'☆'.repeat(5 - post.data.rating)}
                    </span>
                    <span class="sr-only">{`${post.data.rating} 星评分`}</span>
                  </span>
                </>
              )}
              {showReadTime && <span class="heti-skip">·</span>}
              {showReadTime && (
                <div>
                  {i18next.t('blog.readingTime', {
                    minutes: remarkPluginFrontmatter.minutesRead,
                  })}
                </div>
              )}
            </div>
          </div>
        )
      }

      <div
        class:list={['post-content', 'heti', isThread && 'sr-only']}
        data-pagefind-body
      >
        <Content />
      </div>

      {
        /* 正文下面的信息栏。无标题的内容在这里第一次出现日期；有标题的上面已经
         有发布日期了，这里只补「编辑于」。两者都把操作按钮放在这一行。 */
        !isThread && (
          <div class="post-meta-bar">
            <div class="post-meta-bar-facts">
              {!hasTitle && (
                <>
                  <span>{formattedPubDate}</span>
                  {post.data.rating && (
                    <>
                      <span class="heti-skip">·</span>
                      <span>
                        <span aria-hidden="true">
                          {'★'.repeat(post.data.rating)}
                          {'☆'.repeat(5 - post.data.rating)}
                        </span>
                        <span class="sr-only">
                          {`${post.data.rating} 星评分`}
                        </span>
                      </span>
                    </>
                  )}
                  {showReadTime && (
                    <>
                      <span class="heti-skip">·</span>
                      <span>
                        {i18next.t('blog.readingTime', {
                          minutes: remarkPluginFrontmatter.minutesRead,
                        })}
                      </span>
                    </>
                  )}
                </>
              )}
              {showLastModified && (
                <>
                  {!hasTitle && <span class="heti-skip">·</span>}
                  <span>
                    {i18next.t('blog.lastModified')} {lastModified}
                  </span>
                </>
              )}
            </div>
            <PostActions
              slug={post.id}
              collections={post.data.collections ?? []}
              hiddenFromLatest={post.data.hiddenFromLatest}
              draft={post.data.draft}
              featured={post.data.featured}
              pinned={post.data.pinned}
            />
          </div>
        )
      }
      <RelatedPosts posts={relatedPosts} />
    </div>
  </main>
</PageLayout>

<script>
  import Heti from 'heti/js/heti-addon.js';
  import '@/scripts/feed-typography';
  import '@/scripts/thread-collapse';

  // 逐个根节点同步处理并打标记：autoSpacing() 延后查询，防不住重复执行，
  // 跑第二遍会把 <heti-adjacent> 再包一层，句尾标点被压两次。
  const heti = new Heti();

  const applySpacing = () => {
    document
      .querySelectorAll<HTMLElement>(
        '.post-header, .post-content.heti, .post-meta-bar-facts, .related-post-date',
      )
      .forEach((root) => {
        if (root.dataset.hetiDone === 'true') return;
        root.dataset.hetiDone = 'true';
        heti.spacingElement(root);
      });
  };

  applySpacing();
  document.addEventListener('astro:page-load', applySpacing);
</script>
