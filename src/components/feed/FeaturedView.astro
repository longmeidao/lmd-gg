---
import PageLayout from '@/components/layouts/PageLayout.astro';
import BackHeader from '@/components/layouts/BackHeader.astro';
import ThreadGroup from '@/components/feed/ThreadGroup.astro';
import PaginationNav from '@/components/feed/PaginationNav.astro';
import { getFeaturedPostGroups, renderFeedPosts } from '@/helpers/content';
import { paginateItems } from '@/helpers/pagination';
import slateConfig from '~@/slate.config';
import '@/assets/style/home.css';

interface Props {
  page?: number;
}

const { page = 1 } = Astro.props;
const pageSize = slateConfig.pagination?.pageSize ?? 20;
const rawGroups = await getFeaturedPostGroups();
const paginated = paginateItems(rawGroups, page, pageSize);
const rawPosts = paginated.items.flatMap((group) => group.items);
const posts = await renderFeedPosts(rawPosts);
---

<PageLayout title={page > 1 ? `精选辑 · 第 ${page} 页` : '精选辑'}>
  <BackHeader slot="header" />

  <main id="main-content" tabindex="-1" class="home-column">
    <section class="collection-hero">
      <h1 class="home-hero-title text-slate12">精选辑</h1>
    </section>

    <section class="mb-16">
      <div class="home-feed">
        {
          posts.map((item, index) => (
            <div class="home-feed-cluster">
              {index > 0 && (
                <div class="home-group-divider" aria-hidden="true" />
              )}
              <ThreadGroup items={[item]} />
            </div>
          ))
        }
      </div>
      <PaginationNav
        currentPage={paginated.meta.currentPage}
        totalPages={paginated.meta.totalPages}
        basePath="/featured"
      />
    </section>
  </main>
</PageLayout>

<script>
  import '@/scripts/feed-typography';
</script>
