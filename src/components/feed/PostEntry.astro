---
import type { CollectionEntry } from 'astro:content';
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import { getPostDisplayTitle } from '@/helpers/post';
import { getCollectionHref, getPostCollections } from '@/helpers/collection';
// ::: info 这类容器的基础样式。feed 出现在首页/合集/归档/文章页，
// 样式跟着渲染条目的组件走，才不会漏掉某个页面。
import 'remark-block-containers/css';

interface Props {
  item: {
    id: string;
    url: string;
    data: CollectionEntry<'post'>['data'];
    Content: AstroComponentFactory;
  };
  isFirst?: boolean;
  isLast?: boolean;
  isThreadLatest?: boolean;
  /** 串文页里当前被点开的那一条：锚点高亮 */
  isThreadCurrent?: boolean;
  /** 串文页里被压暗的旧内容 */
  isDimmed?: boolean;
  /** 合集页里已经在这个合集下了，footer 不用再重复列出来 */
  hideCollections?: boolean;
  /** 置顶标记只在按置顶排序的列表里有意义（首页最新），别处不显示 */
  showPinned?: boolean;
  /**
   * 透传到 <article> 上的 data-*。归档/合集的前端筛选按条隐藏，标记必须挂在
   * 条目本身，否则串成一组之后没法单独筛某一条。
   */
  itemAttrs?: Record<string, string>;
}

const {
  item,
  isFirst,
  isLast,
  isThreadLatest,
  isThreadCurrent,
  isDimmed,
  hideCollections = false,
  showPinned: showPinnedProp = false,
  itemAttrs = {},
} = Astro.props;

const showPinned = showPinnedProp && item.data.pinned === true;
/* 草稿只有登录后才看得到（dev 直接构建进来，生产由脚本注入），
   所以这里不用再判鉴权。标记要和注入草稿那份一致，见 scripts/archive.ts。 */
const showDraft = item.data.draft === true;
const kind = item.data.kind;
const externalUrl = item.data.externalUrl;
const displayTitle = getPostDisplayTitle(item.data);
const collections = getPostCollections(item.data);

const date = item.data.pubDate?.toLocaleDateString('zh-CN', {
  timeZone: 'Asia/Taipei',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const displayDomain = (() => {
  if (!externalUrl) return '';
  try {
    return new URL(externalUrl).hostname.replace(/^www\./i, '');
  } catch {
    return (
      externalUrl.replace(/^https?:\/\//i, '').split('/')[0] ?? externalUrl
    );
  }
})();
---

<article
  {...itemAttrs}
  data-post-item
  data-kind={kind}
  data-collections={JSON.stringify(collections)}
  class:list={[
    'home-feed-item',
    isFirst && 'is-first-visible',
    isLast && 'is-last-visible',
    (isThreadLatest || isThreadCurrent) && 'is-thread-latest',
    isThreadCurrent && 'is-thread-current',
    isDimmed && 'is-thread-dimmed',
  ]}
>
  {
    /* 置顶标记，规格照 owenyoung.com 的 .post-status-badge：图钉 + 文字，
       没有底色也没有边框，压得比正文弱一档，贴在条目最上面。
       串文页里不重复显示 —— 那儿排序本来就不按置顶走。 */
    showDraft && (
      <p class="home-entry-status">
        <span class="home-entry-status-badge home-entry-status-draft">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12 20h9" />
            <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z" />
          </svg>
          草稿
        </span>
      </p>
    )
  }
  {
    showPinned && !showDraft && (
      <p class="home-entry-status">
        <span class="home-entry-status-badge">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="12" x2="12" y1="17" y2="22" />
            <path d="M5 17h14v-1.76a2 2 0 0 0-1.11-1.79l-1.78-.9A2 2 0 0 1 15 10.76V6h1a2 2 0 0 0 0-4H8a2 2 0 0 0 0 4h1v4.76a2 2 0 0 1-1.11 1.79l-1.78.9A2 2 0 0 0 5 15.24Z" />
          </svg>
          置顶
        </span>
      </p>
    )
  }
  {
    kind === 'article' ? (
      <div class="home-article">
        <h2 class="home-article-title">
          <a href={item.url}>{displayTitle}</a>
        </h2>
        <div class="home-entry-content home-article-content">
          <item.Content />
        </div>
      </div>
    ) : (
      <div>
        {kind === 'link' && externalUrl ? (
          <div class="home-link-card">
            <span class="home-link-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <path d="M14 5h5v5M19 5l-9 9" />
                <path d="M17 13v5a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V8a1 1 0 0 1 1-1h5" />
              </svg>
            </span>
            <a
              class="home-link-url"
              href={externalUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              {displayDomain}
            </a>
            <a
              class="home-link-title"
              href={externalUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              {displayTitle}
            </a>
            <div class="home-entry-content">
              <item.Content />
            </div>
          </div>
        ) : kind === 'quote' ? (
          <div class="home-quote-card">
            <span class="home-quote-mark" aria-hidden="true">
              “
            </span>
            {item.data.title && (
              <a class="home-entry-title" href={item.url}>
                {item.data.title}
              </a>
            )}
            <div class="home-entry-content">
              <item.Content />
            </div>
            {item.data.source && (
              <span class="home-entry-source">
                {externalUrl ? (
                  <a
                    href={externalUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {item.data.source}
                  </a>
                ) : (
                  item.data.source
                )}
              </span>
            )}
          </div>
        ) : (
          <>
            {item.data.title && (
              <header class="home-entry-header">
                {kind === 'note' && (
                  /* 纯装饰图标：原来挂的 aria-label={kind} 会把内部枚举值
                     「note」念给中文站点的读屏用户，而 ARIA 也不允许在
                     role=generic 上用 aria-label。 */
                  <span class="home-entry-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M6 4h12a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-7l-5 3v-3a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z" />
                    </svg>
                  </span>
                )}
                <a class="home-entry-title" href={item.url}>
                  {item.data.title}
                </a>
              </header>
            )}
            <div class="home-entry-content">
              <item.Content />
            </div>
          </>
        )}
        {item.data.commentary && (
          <div class="home-entry-commentary">
            <p>{item.data.commentary}</p>
          </div>
        )}
      </div>
    )
  }

  <footer class="home-entry-footer">
    <a
      class="home-entry-date-link"
      href={item.url}
      aria-label={`打开「${displayTitle}」`}
    >
      <time class="home-entry-date" datetime={item.data.pubDate?.toISOString()}>
        {date}
      </time>
    </a>
    {
      item.data.rating && (
        /* 星星本身交给视觉，文字说明单独给读屏。
           aria-label 挂在无角色的 span 上按 ARIA 1.2 是不允许的，各家支持也不一致。 */
        <span class="home-entry-rating">
          <span aria-hidden="true">
            {'★'.repeat(item.data.rating)}
            {'☆'.repeat(5 - item.data.rating)}
          </span>
          <span class="sr-only">{`${item.data.rating} 星评分`}</span>
        </span>
      )
    }
    {
      !hideCollections && collections.length > 0 && (
        <span class="home-entry-collections">
          <span class="sr-only">合集</span>
          {collections.map((name) => (
            <a href={getCollectionHref(name)}>{name}</a>
          ))}
        </span>
      )
    }
    <slot />
  </footer>
</article>
