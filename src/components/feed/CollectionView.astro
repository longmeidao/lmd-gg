---
import { getCollection } from 'astro:content';
import PageLayout from '@/components/layouts/PageLayout.astro';
import BackHeader from '@/components/layouts/BackHeader.astro';
import PostActions from '@/components/admin/PostActions.astro';
import PostEntry from '@/components/feed/PostEntry.astro';
import FilterBar from '@/components/feed/FilterBar.astro';
import PaginationNav from '@/components/feed/PaginationNav.astro';
import { groupPostThreads, renderFeedPosts } from '@/helpers/content';
import {
  getCollectionHref,
  getCollectionSlug,
  getPostCollections,
} from '@/helpers/collection';
import { buildFilters, detectMedia } from '@/helpers/filters';
import { paginateItems } from '@/helpers/pagination';
import slateConfig from '~@/slate.config';
import '@/assets/style/home.css';
import '@/assets/style/archive.css';

interface Props {
  name: string;
  count: number;
  ids: string[];
  page?: number;
}

const { name, count, ids, page = 1 } = Astro.props;

const all = await getCollection('post');
const selectedPosts = ids.map((id) => all.find((post) => post.id === id)!);
const pageSize = slateConfig.pagination?.pageSize ?? 20;
const paginated = paginateItems(
  groupPostThreads(selectedPosts),
  page,
  pageSize,
);
const pagePosts = paginated.items.flatMap((group) => group.items);
const posts = await Promise.all(
  (await renderFeedPosts(pagePosts)).map(async (post) => {
    const source = all.find((entry) => entry.id === post.id)!;
    const date = post.data.pubDate;
    return {
      ...post,
      // 以下都是筛选用的：和归档页同一套判定，同一个脚本消费
      kind: post.data.kind,
      year: date ? date.getFullYear() : 0,
      hasTitle: Boolean(post.data.title?.trim()),
      isThread: Boolean(post.data.thread),
      media: detectMedia(
        source.body,
        post.data.kind,
        post.data.attached === true,
      ),
      collections: getPostCollections(post.data),
      visibility: post.data.draft
        ? 'private'
        : post.data.hiddenFromLatest
          ? 'hidden'
          : 'public',
    };
  }),
);

// 页面本身就限定了合集，再给一个合集筛选没有意义
const filters = buildFilters(posts, { includeCollection: false });
const feedHref = `/rss/${getCollectionSlug(name)}.xml`;
---

<PageLayout
  title={page > 1 ? `${name} · 第 ${page} 页` : name}
  description={`合集「${name}」下的 ${count} 条内容。`}
>
  <link
    slot="head"
    rel="alternate"
    type="application/rss+xml"
    title={`${name} 的 RSS`}
    href={feedHref}
  />
  <BackHeader slot="header" />

  <main class="home-column" data-archive-body>
    <section class="collection-hero">
      <h1 class="home-hero-title text-slate12">{name}</h1>
      <FilterBar
        filters={filters}
        count={posts.length}
        feedHref={feedHref}
        feedTitle={`订阅合集「${name}」`}
      />
    </section>

    <section class="mb-16">
      <div class="home-feed">
        {
          posts.map((item, index) => (
            <div
              class="home-feed-cluster"
              data-archive-item
              data-kind={item.kind}
              data-year={String(item.year)}
              data-has-title={String(item.hasTitle)}
              data-thread={String(item.isThread)}
              data-media={item.media.join(',')}
              data-collections={JSON.stringify(item.collections)}
              data-visibility={item.visibility}
              data-featured={String(item.data.featured === true)}
            >
              {index > 0 && (
                <div class="home-group-divider" aria-hidden="true" />
              )}
              <section class="home-feed-group" data-visible-count="1">
                <PostEntry item={item} isFirst isLast>
                  <PostActions
                    slug={item.id}
                    collections={item.data.collections ?? []}
                    hiddenFromLatest={item.data.hiddenFromLatest}
                    draft={item.data.draft}
                    featured={item.data.featured}
                    pinned={item.data.pinned}
                  />
                </PostEntry>
              </section>
            </div>
          ))
        }
      </div>
      <p class="archive-empty" data-archive-empty hidden>
        没有符合条件的内容。
      </p>
      <PaginationNav
        currentPage={paginated.meta.currentPage}
        totalPages={paginated.meta.totalPages}
        basePath={getCollectionHref(name)}
      />
    </section>
  </main>
</PageLayout>

<script>
  import '@/scripts/feed-typography';
  import '@/scripts/archive';
</script>
