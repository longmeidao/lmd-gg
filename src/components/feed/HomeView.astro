---
import PageLayout from '@/components/layouts/PageLayout.astro';
import ThreadGroup from '@/components/feed/ThreadGroup.astro';
import PaginationNav from '@/components/feed/PaginationNav.astro';
import { getPostDisplayTitle } from '@/helpers/post';
import { getLatestPostGroups, renderFeedPosts } from '@/helpers/content';
import { getPageSize, paginateItems } from '@/helpers/pagination';
import slateConfig from '~@/slate.config';
import '@/assets/style/home.css';

interface Props {
  page?: number;
}

const { page = 1 } = Astro.props;
const pageSize = getPageSize();
const rawGroups = await getLatestPostGroups();
const paginated = paginateItems(rawGroups, page, pageSize);
const postGroups = await Promise.all(
  paginated.items.map(async (group) => ({
    ...group,
    items: await renderFeedPosts(group.items),
  })),
);
---

<PageLayout title={page > 1 ? `第 ${page} 页` : undefined}>
  <main id="main-content" tabindex="-1" class="home-column">
    <section class="relative mb-14">
      <h1 class="home-hero-title text-slate12">
        <a href="/">{slateConfig.title}</a>
      </h1>
      <nav class="home-nav mt-5" aria-label="站点导航">
        {
          slateConfig.navigations?.map((navigation) => (
            <a href={navigation.href}>{navigation.label}</a>
          ))
        }
      </nav>
    </section>

    <section id="post-list-section" class="mb-16 scroll-mt-8">
      {/* 静态 feed 不使用 aria-live，避免排版脚本触发重复播报。 */}
      <div id="post-list" class="home-feed">
        {
          postGroups.map((group, groupIndex) => (
            <div class="home-feed-cluster" data-feed-cluster>
              {groupIndex > 0 && (
                <div class="home-group-divider" aria-hidden="true" />
              )}
              <ThreadGroup
                items={group.items}
                thread={group.thread}
                ariaLabel={
                  group.thread
                    ? `${group.items.length} 条关联内容`
                    : getPostDisplayTitle(group.items[0]!.data)
                }
                showPinned
                feedGroup
              />
            </div>
          ))
        }
      </div>
      <PaginationNav
        currentPage={paginated.meta.currentPage}
        totalPages={paginated.meta.totalPages}
        basePath="/"
      />
    </section>
  </main>
</PageLayout>

<script>
  import '@/scripts/feed-typography';
  import '@/scripts/thread-collapse';
</script>
