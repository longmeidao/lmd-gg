---
import slateConfig from '~@/slate.config';
import HeaderActions from './HeaderActions.astro';

interface Props {
  avatar?: string;
}

const { avatar = slateConfig.avatar } = Astro.props;
---

<header class="mb-9 flex h-14 items-start justify-between">
  <a class="block h-14 w-14 text-[0px] whitespace-nowrap" href="/">
    <img
      class="bg-slate2 outline-slate3 block h-full w-full rounded-full border-2 border-white shadow-xs outline-1"
      src={avatar}
      alt={slateConfig.title}
      draggable="false"
    />
    <span>{slateConfig.title}</span>
  </a>
  <HeaderActions />
</header>
