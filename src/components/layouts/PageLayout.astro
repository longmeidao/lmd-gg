---
import { ClientRouter } from 'astro:transitions';
import HeadMeta from './HeadMeta.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import NormalJsonLd from '@/components/json-ld/normal.astro';
import slateConfig from '~@/slate.config';
import { getFullTitle } from '@/helpers/utils';
import '@/assets/style/common.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  robots?: string;
}

const {
  title = '',
  description,
  image = '/images/og_image.png',
  robots,
} = Astro.props;
const fullTitle = getFullTitle(title);

// 首屏绘制前先定好主题，否则深色模式会先闪一下浅色
const themeScript = `
  function getThemeMode() {
    const theme = localStorage.getItem('theme');
    if (theme && (theme === 'light' || theme === 'dark')) return theme;

    const presetTheme = theme === 'auto' ? theme : '${slateConfig.theme?.mode}';
    if (presetTheme === 'auto')
      return window.matchMedia('(prefers-color-scheme: dark)').matches
        ? 'dark'
        : 'light';

    return presetTheme;
  }
  function applyTheme() {
    const mode = getThemeMode();
    document.documentElement.className = mode;
    document.documentElement.dataset.theme = mode;
  }
  applyTheme();
  document.addEventListener('astro:after-swap', applyTheme);
`;
---

<!doctype html>
<html lang={slateConfig.lang}>
  <head>
    <HeadMeta
      title={fullTitle}
      description={description}
      image={image}
      robots={robots}
    />
    <slot name="json-ld">
      <NormalJsonLd title={fullTitle} description={description} image={image} />
    </slot>
    <slot name="head" />
    {
      import.meta.env.PROD && (
        <script
          is:inline
          defer
          src="https://umami.lmd.gg/script.js"
          data-website-id="4e5cf502-20bc-4a44-89ee-31ea469e15b4"
        />
      )
    }
    <script is:inline set:html={themeScript} />
    <ClientRouter />
  </head>
  <body class="bg-slate1">
    {
      /* 键盘用户的第一个落点：不然每换一页都要先 Tab 过头像、撰写、搜索、导航
        才能进正文。平时不可见，聚焦时才出现。 */
    }
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    <script is:inline>
      /*
       * 自己把焦点送进 <main>：光靠 href="#main-content" 不行，ClientRouter 会
       * 接管同页锚点跳转，按下回车后 hash 没变、焦点被打回 body。document 不会
       * 被换页替换掉，所以只绑一次。
       */
      document.addEventListener('click', (event) => {
        const link = event.target.closest?.('.skip-link');
        if (!link) return;
        const main = document.getElementById('main-content');
        if (!main) return;
        event.preventDefault();
        main.focus();
        main.scrollIntoView();
      });
    </script>
    <div class="site-shell flex min-h-dvh flex-col pt-18 pb-6">
      <slot name="header">
        <Header />
      </slot>
      <slot />
      <slot name="footer">
        <Footer />
      </slot>
    </div>
  </body>
</html>
