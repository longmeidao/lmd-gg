---
import { ClientRouter } from 'astro:transitions';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import HeadMeta from './HeadMeta.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import NormalJsonLd from '@/components/json-ld/normal.astro';
import slateConfig from '~@/slate.config';
import { getFullTitle } from '@/helpers/utils';
import '@/assets/style/common.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  robots?: string;
}

const {
  title = '',
  description,
  image = '/images/og_image.png',
  robots,
} = Astro.props;
const fullTitle = getFullTitle(title);

// Cloudflare 没有 Vercel 的 /_vercel/* 路由，使用公开 DSN 直连官方采集脚本。
const isVercelBuild = process.env.VERCEL === '1';
const speedInsightsDsn = isVercelBuild
  ? undefined
  : 'fsTh9umJxwfHAT9qKbEawMs5h2r';
const analyticsDsn = isVercelBuild ? undefined : 'qx5reBHX4WLwYVxjvSZK4483M';
const analyticsScriptSrc = isVercelBuild
  ? undefined
  : 'https://va.vercel-scripts.com/v1/script.js';

// 首屏绘制前确定主题，避免颜色闪烁。
const themeScript = `
  function getThemeMode() {
    const theme = localStorage.getItem('theme');
    if (theme && (theme === 'light' || theme === 'dark')) return theme;

    const presetTheme = theme === 'auto' ? theme : '${slateConfig.theme?.mode}';
    if (presetTheme === 'auto')
      return window.matchMedia('(prefers-color-scheme: dark)').matches
        ? 'dark'
        : 'light';

    return presetTheme;
  }
  function applyTheme() {
    const mode = getThemeMode();
    document.documentElement.className = mode;
    document.documentElement.dataset.theme = mode;
  }
  applyTheme();
  document.addEventListener('astro:after-swap', applyTheme);
`;
---

<!doctype html>
<html lang={slateConfig.lang}>
  <head>
    <HeadMeta
      title={fullTitle}
      description={description}
      image={image}
      robots={robots}
    />
    <slot name="json-ld">
      <NormalJsonLd title={fullTitle} description={description} image={image} />
    </slot>
    <slot name="head" />
    <SpeedInsights dsn={speedInsightsDsn} />
    {
      import.meta.env.PROD && (
        <script
          is:inline
          defer
          src="https://umami.lmd.gg/script.js"
          data-website-id="4e5cf502-20bc-4a44-89ee-31ea469e15b4"
        />
      )
    }
    <Analytics dsn={analyticsDsn} scriptSrc={analyticsScriptSrc} />
    <script is:inline set:html={themeScript} />
    <ClientRouter />
  </head>
  <body class="bg-slate1">
    {/* 键盘用户可直接跳到正文；链接仅在聚焦时显示。 */}
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    <script is:inline>
      /* ClientRouter 不会可靠移动同页锚点焦点，因此显式聚焦 main。 */
      document.addEventListener('click', (event) => {
        const link = event.target.closest?.('.skip-link');
        if (!link) return;
        const main = document.getElementById('main-content');
        if (!main) return;
        event.preventDefault();
        main.focus();
        main.scrollIntoView();
      });
    </script>
    <div class="site-shell flex min-h-dvh flex-col pt-18 pb-6">
      <slot name="header">
        <Header />
      </slot>
      <slot />
      <slot name="footer">
        <Footer />
      </slot>
    </div>
  </body>
</html>
