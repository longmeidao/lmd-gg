---
import { ClientRouter } from 'astro:transitions';
import HeadMeta from './HeadMeta.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import NormalJsonLd from '@/components/json-ld/normal.astro';
import slateConfig from '~@/slate.config';
import { getFullTitle } from '@/helpers/utils';
import '@/assets/style/common.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  robots?: string;
}

const {
  title = '',
  description = slateConfig.description,
  image = '/images/og_image.png',
  robots,
} = Astro.props;
const fullTitle = getFullTitle(title);

// Apply the theme before first paint to avoid a light/dark flash.
const themeScript = `
  function getThemeMode() {
    const theme = localStorage.getItem('theme');
    if (theme && (theme === 'light' || theme === 'dark')) return theme;

    const presetTheme = theme === 'auto' ? theme : '${slateConfig.theme?.mode}';
    if (presetTheme === 'auto')
      return window.matchMedia('(prefers-color-scheme: dark)').matches
        ? 'dark'
        : 'light';

    return presetTheme;
  }
  function applyTheme() {
    const mode = getThemeMode();
    document.documentElement.className = mode;
    document.documentElement.dataset.theme = mode;
  }
  applyTheme();
  document.addEventListener('astro:after-swap', applyTheme);
`;
---

<!doctype html>
<html lang={slateConfig.lang}>
  <head>
    <HeadMeta
      title={fullTitle}
      description={description}
      image={image}
      robots={robots}
    />
    <slot name="json-ld">
      <NormalJsonLd title={fullTitle} description={description} image={image} />
    </slot>
    <slot name="head" />
    <script
      is:inline
      defer
      src="https://umami.lmd.gg/script.js"
      data-website-id="4e5cf502-20bc-4a44-89ee-31ea469e15b4"></script>
    <script is:inline set:html={themeScript} />
    <ClientRouter />
  </head>
  <body class="bg-slate1">
    <div class="site-shell flex min-h-dvh flex-col pt-18 pb-6">
      <slot name="header">
        <Header />
      </slot>
      <slot />
      <slot name="footer">
        <Footer />
      </slot>
    </div>
  </body>
</html>
