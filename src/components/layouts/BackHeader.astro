---
import Button from '@/components/button';
import HeaderActions from './HeaderActions.astro';

/** 非首页页头；调用方需要显式传入 `slot="header"`。 */
---

<div class="mb-16 flex h-14 items-start justify-between">
  {/* 箭头仅作装饰，链接名称由 aria-label 提供。 */}
  <Button href="/" aria-label="回到首页">
    <span aria-hidden="true">←</span>
  </Button>
  <HeaderActions />
</div>
