---
import { getPostPath, type PostKind } from '@/helpers/post';
interface RelatedPost {
  title: string;
  id: string;
  description?: string;
  pubDate?: Date;
  collections: string[];
  kind: PostKind;
}

interface Props {
  posts: RelatedPost[];
}

const { posts } = Astro.props;
---

{
  posts.length > 0 && (
    <section class="related-posts mt-16" aria-labelledby="related-posts-title">
      <div
        class="home-group-divider related-posts-divider"
        aria-hidden="true"
      />
      <h3
        id="related-posts-title"
        class="text-slate12 mb-6 ml-3 text-base font-semibold"
      >
        相关文章
      </h3>
      <div class="text-slate12 text-base">
        {posts.map((post) => (
          <a
            class="related-post active:bg-slate4 sm:hover:bg-slate3 group mt-4 flex cursor-pointer flex-col rounded-xl px-3 pt-3 no-underline transition-all hover:no-underline active:scale-[0.995]"
            href={getPostPath(post.id)}
            title={post.title}
          >
            <div class="min-w-0 flex-1">
              <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between">
                <span class="text-slate12 shrink-0 font-medium">
                  {post.title}
                </span>
                <span class="related-post-rule border-slate6 mx-8 hidden h-px w-full grow border-t border-dashed sm:flex" />
                {post.pubDate && (
                  <time
                    class="related-post-date heti text-slate8 shrink-0"
                    datetime={post.pubDate.toISOString()}
                  >
                    {post.pubDate.toLocaleDateString('zh-CN', {
                      year: 'numeric',
                      month: 'long',
                      day: 'numeric',
                    })}
                  </time>
                )}
              </div>
              {post.description && (
                <p class="text-slate10 mt-2 line-clamp-2 text-sm">
                  {post.description}
                </p>
              )}
              {post.collections.length > 0 && (
                <div class="related-post-collections mx-1 mt-3 flex flex-wrap gap-1.5">
                  {post.collections.slice(0, 3).map((tag) => (
                    <span class="bg-slate5 group-hover:bg-slate6 text-slate10 rounded-full px-3 py-0.5 text-sm transition-colors">
                      {tag}
                    </span>
                  ))}
                  {post.collections.length > 3 && (
                    <span class="text-slate8 px-1 py-0.5 text-xs">
                      +{post.collections.length - 3}
                    </span>
                  )}
                </div>
              )}
            </div>
          </a>
        ))}
      </div>
    </section>
  )
}
