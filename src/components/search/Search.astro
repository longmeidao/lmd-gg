---
import './search.css';
---

<button
  type="button"
  class="header-action site-search-trigger"
  aria-label="搜索"
  data-search-open
>
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="11" cy="11" r="6.5"></circle>
    <path d="m16 16 4 4"></path>
  </svg>
  <span>搜索</span>
</button>

<dialog class="site-search-dialog" aria-label="搜索本站" data-search-dialog>
  <section class="site-search-panel">
    <div class="site-search-box">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="11" cy="11" r="6.5"></circle>
        <path d="m16 16 4 4"></path>
      </svg>
      <input
        type="search"
        placeholder="搜索文章…"
        autocomplete="off"
        spellcheck="false"
        aria-label="搜索文章"
        data-search-input
      />
      <kbd>ESC</kbd>
    </div>
    {/* 索引只覆盖 data-pagefind-body，不包含标签。 */}
    <p class="site-search-status" aria-live="polite" data-search-status>
      输入标题或正文关键词
    </p>
    <ul class="site-search-results" data-search-results hidden></ul>
  </section>
</dialog>

<script is:inline type="module">
  // 每次操作重新查询软导航后的 DOM；document 级快捷键只注册一次。
  const q = (selector) => document.querySelector(selector);

  /** 校验 Pagefind 忽略的未命中词。 */
  const termsOf = (query) => {
    if (typeof Intl !== 'undefined' && Intl.Segmenter) {
      const segmenter = new Intl.Segmenter('zh-CN', { granularity: 'word' });
      return [...segmenter.segment(query)]
        .filter((part) => part.isWordLike)
        .map((part) => part.segment.toLowerCase());
    }
    return query.toLowerCase().split(/\s+/).filter(Boolean);
  };

  const matchesAll = (item, terms) => {
    const haystack =
      `${item.raw_content ?? ''} ${item.meta?.title ?? ''}`.toLowerCase();
    return terms.every((term) => haystack.includes(term));
  };

  /** 摘要仅保留 Pagefind 生成的 mark 和文本。 */
  const appendHighlighted = (target, html) => {
    const parsed = new DOMParser().parseFromString(html, 'text/html');
    parsed.body.childNodes.forEach((node) => {
      const isMark = node.nodeName === 'MARK';
      const text = node.textContent ?? '';
      if (!isMark) {
        target.append(text);
        return;
      }
      // 合并相邻 mark，避免高亮之间出现空隙。
      const previous = target.lastChild;
      if (previous && previous.nodeName === 'MARK') {
        previous.textContent += text;
        return;
      }
      const mark = document.createElement('mark');
      mark.textContent = text;
      target.append(mark);
    });
  };

  const appendMarkedTitle = (target, title, terms) => {
    const lower = title.toLowerCase();
    const hits = [];
    terms.forEach((term) => {
      let from = 0;
      for (;;) {
        const at = lower.indexOf(term, from);
        if (at < 0) break;
        hits.push([at, at + term.length]);
        from = at + term.length;
      }
    });
    if (hits.length === 0) {
      target.textContent = title;
      return;
    }
    hits.sort((a, b) => a[0] - b[0]);
    // 合并重叠区间。
    const merged = [];
    hits.forEach(([start, end]) => {
      const last = merged.at(-1);
      if (last && start <= last[1]) last[1] = Math.max(last[1], end);
      else merged.push([start, end]);
    });
    let cursor = 0;
    merged.forEach(([start, end]) => {
      if (start > cursor) target.append(title.slice(cursor, start));
      const mark = document.createElement('mark');
      mark.textContent = title.slice(start, end);
      target.append(mark);
      cursor = end;
    });
    if (cursor < title.length) target.append(title.slice(cursor));
  };

  let pagefindPromise;
  let searchTimer;
  let searchSequence = 0;

  const loadPagefind = () => {
    if (!pagefindPromise) {
      pagefindPromise = import('/pagefind/pagefind.js').then(
        async (pagefind) => {
          await pagefind.init?.();
          return pagefind;
        },
      );
    }
    return pagefindPromise;
  };

  const openSearch = () => {
    const dialog = q('[data-search-dialog]');
    if (!dialog) return;
    if (!dialog.open) dialog.showModal();
    q('[data-search-input]')?.focus();
    void loadPagefind().catch(() => undefined);
  };

  const closeSearch = () => {
    q('[data-search-dialog]')?.close();
    q('[data-search-open]')?.focus();
  };

  const renderResults = (items, terms) => {
    const results = q('[data-search-results]');
    if (!results) return;
    results.replaceChildren();

    for (const item of items) {
      const listItem = document.createElement('li');
      const anchor = document.createElement('a');
      const title = document.createElement('strong');
      const excerpt = document.createElement('span');
      const path = document.createElement('small');

      anchor.href = item.url;
      appendMarkedTitle(title, item.meta?.title || '未命名文章', terms);
      if (item.excerpt) appendHighlighted(excerpt, item.excerpt);
      else excerpt.textContent = item.plain_excerpt || '打开这篇文章';
      path.textContent = new URL(item.url, window.location.origin).pathname;
      anchor.append(title, excerpt, path);
      listItem.appendChild(anchor);
      results.appendChild(listItem);
    }

    results.hidden = items.length === 0;
  };

  const runSearch = async () => {
    const input = q('[data-search-input]');
    const status = q('[data-search-status]');
    const results = q('[data-search-results]');
    if (!input || !status || !results) return;

    const query = input.value.trim();
    const sequence = ++searchSequence;

    if (!query) {
      results.replaceChildren();
      results.hidden = true;
      status.textContent = '输入标题或正文关键词';
      return;
    }

    status.textContent = '正在搜索…';

    try {
      const pagefind = await loadPagefind();
      const response = await pagefind.search(query);
      const terms = termsOf(query);
      const fetched = await Promise.all(
        response.results.slice(0, 20).map((result) => result.data()),
      );
      if (sequence !== searchSequence) return;
      const items = fetched
        .filter((item) => matchesAll(item, terms))
        .slice(0, 8);
      renderResults(items, terms);
      status.textContent =
        items.length > 0 ? `找到 ${items.length} 个结果` : '没有找到相关内容';
    } catch {
      if (sequence !== searchSequence) return;
      results.replaceChildren();
      results.hidden = true;
      status.textContent = '搜索暂时不可用，请稍后再试。';
    }
  };

  const setup = () => {
    const dialog = q('[data-search-dialog]');
    const openButton = q('[data-search-open]');
    const input = q('[data-search-input]');
    if (!dialog || !openButton || !input) return;
    if (dialog.dataset.searchReady === 'true') return;
    dialog.dataset.searchReady = 'true';

    openButton.addEventListener('click', openSearch);
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) closeSearch();
    });
    input.addEventListener('input', () => {
      window.clearTimeout(searchTimer);
      searchTimer = window.setTimeout(runSearch, 160);
    });
  };

  // document 不受软导航影响，快捷键只注册一次。
  if (!window.__lmdSearchShortcut) {
    window.__lmdSearchShortcut = true;
    document.addEventListener('keydown', (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
        event.preventDefault();
        openSearch();
      }
    });
  }

  setup();
  document.addEventListener('astro:page-load', setup);
</script>
