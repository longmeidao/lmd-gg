{
  "name": "lmd-gg",
  "version": "1.0.0",
  "description": "Pure thoughts, simple stories",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24 <27",
    "pnpm": "10.x"
  },
  "homepage": "https://lmd.gg",
  "repository": {
    "type": "git",
    "url": "https://github.com/longmeidao/lmd-gg.git"
  },
  "bugs": {
    "url": "https://github.com/longmeidao/lmd-gg/issues"
  },
  "sideEffects": false,
  "author": "kim, bluepikachu",
  "scripts": {
    "prepare": "husky",
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro sync && pnpm run tsc && astro check && astro build && pnpm run verify:rss",
    "preview": "astro preview",
    "astro": "astro",
    "tsc": "tsc --noEmit",
    "lint": "pnpm run tsc && pnpm run lint:script && astro check",
    "lint-fix": "pnpm run lint-fix:script",
    "lint-fix:script": "pnpm run lint:script -- --fix",
    "lint:script": "eslint",
    "verify:rss": "node scripts/verify-rss.mjs",
    "format": "prettier --write \"src/**/*.{js,ts,jsx,tsx,astro}\"",
    "sync-latest": "./scripts/sync-latest-blog.sh"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.1",
    "@astrojs/mdx": "^7.0.3",
    "@astrojs/react": "^6.0.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@docsearch/css": "^4.6.3",
    "@docsearch/react": "^4.6.3",
    "@radix-ui/colors": "^3.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.1",
    "astro-expressive-code": "^0.44.0",
    "classnames": "^2.5.1",
    "dayjs": "^1.11.21",
    "heti": "^0.9.6",
    "i18next": "^26.3.6",
    "mdast-util-to-string": "^4.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "reading-time": "^1.5.0",
    "rehype-figure": "^1.0.1",
    "rehype-katex": "^7.0.1",
    "remark-block-containers": "^1.1.0",
    "remark-code-import": "^1.2.0",
    "remark-gemoji": "^8.0.0",
    "remark-math": "^6.0.0",
    "sanitize-html": "^2.17.6",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "vite-plugin-svgr": "^5.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-angular": "^21.2.0",
    "@eslint/js": "9.39.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "@typescript-eslint/parser": "^8.64.0",
    "astro-eslint-parser": "^3.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.5",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0"
  }
}
