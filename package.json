{
  "name": "lmd-gg",
  "version": "1.0.0",
  "description": "Pure thoughts, simple stories",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24 <27",
    "pnpm": "10.x"
  },
  "homepage": "https://lmd.gg",
  "repository": {
    "type": "git",
    "url": "https://github.com/longmeidao/lmd-gg.git"
  },
  "bugs": {
    "url": "https://github.com/longmeidao/lmd-gg/issues"
  },
  "sideEffects": [
    "./src/scripts/*.ts"
  ],
  "author": "kim, bluepikachu",
  "scripts": {
    "prepare": "husky",
    "dev": "astro dev",
    "start": "astro dev",
    "build": "pnpm run tsc && astro check && astro build && pnpm run search:index && pnpm run verify:rss",
    "preview": "astro preview",
    "astro": "astro",
    "tsc": "pnpm run cf:types && astro sync && tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "lint": "pnpm run tsc && pnpm run lint:script && astro check",
    "lint-fix": "pnpm run lint-fix:script",
    "lint-fix:script": "pnpm run lint:script -- --fix",
    "lint:script": "eslint",
    "search:index": "pagefind --site dist",
    "verify:rss": "node scripts/verify-rss.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "verify": "pnpm format:check && pnpm test && pnpm lint && pnpm build",
    "cf:deploy": "pnpm build && wrangler deploy",
    "cf:dev": "wrangler dev",
    "cf:types": "wrangler types"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/react": "^6.0.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@emoji-mart/data": "^1.2.1",
    "@radix-ui/colors": "^3.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.6",
    "astro-expressive-code": "^0.44.1",
    "classnames": "^2.5.1",
    "dayjs": "^1.11.21",
    "emoji-mart": "^5.6.0",
    "heti": "^0.9.6",
    "i18next": "^26.3.6",
    "mdast-util-to-string": "^4.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "reading-time": "^1.5.0",
    "rehype-figure": "^1.0.1",
    "rehype-katex": "^7.0.1",
    "remark-block-containers": "^1.1.0",
    "remark-code-import": "^1.2.0",
    "remark-gemoji": "^8.0.0",
    "remark-math": "^6.0.0",
    "sanitize-html": "^2.17.6",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "vite-plugin-svgr": "^5.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/vitest-pool-workers": "^0.20.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-angular": "^21.2.0",
    "@eslint/js": "9.39.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/sanitize-html": "^2.16.1",
    "@typescript-eslint/parser": "^8.65.0",
    "astro-eslint-parser": "^3.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "remark-cjk-friendly": "^2.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  }
}
