{
  "name": "lmd-gg",
  "version": "1.0.0",
  "description": "Pure thoughts, simple stories",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": "24.x",
    "pnpm": "11.x"
  },
  "homepage": "https://lmd.gg",
  "repository": {
    "type": "git",
    "url": "https://github.com/longmeidao/lmd-gg.git"
  },
  "bugs": {
    "url": "https://github.com/longmeidao/lmd-gg/issues"
  },
  "sideEffects": [
    "./src/scripts/*.ts"
  ],
  "author": "kim, bluepikachu",
  "scripts": {
    "prepare": "husky",
    "dev": "astro dev",
    "start": "astro dev",
    "build": "pnpm run tsc && astro check && astro build && pnpm run search:index && pnpm run verify:rss",
    "preview": "astro preview",
    "astro": "astro",
    "tsc": "pnpm run cf:types && astro sync && tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "lint": "pnpm run tsc && pnpm run lint:script && astro check",
    "lint-fix": "pnpm run lint-fix:script",
    "lint-fix:script": "pnpm run lint:script -- --fix",
    "lint:script": "eslint",
    "search:index": "pagefind --site dist",
    "verify:rss": "node scripts/verify-rss.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "verify": "pnpm format:check && pnpm test && pnpm run lint:script && pnpm build",
    "cf:deploy": "pnpm build && wrangler deploy",
    "cf:dev": "wrangler dev",
    "cf:types": "wrangler types"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.4",
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/react": "^6.0.4",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@emoji-mart/data": "^1.2.1",
    "@radix-ui/colors": "^3.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "astro": "^7.2.9",
    "astro-expressive-code": "^0.44.1",
    "classnames": "^2.5.1",
    "dayjs": "^1.11.23",
    "emoji-mart": "^5.6.0",
    "heti": "^0.9.6",
    "i18next": "^26.4.0",
    "mdast-util-to-string": "^4.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "reading-time": "^1.5.0",
    "rehype-figure": "^1.0.1",
    "rehype-katex": "^7.0.1",
    "remark-block-containers": "^1.1.0",
    "remark-code-import": "^1.2.0",
    "remark-gemoji": "^8.0.0",
    "remark-math": "^6.0.0",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "vite-plugin-svgr": "^5.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-angular": "^21.2.2",
    "@eslint/js": "9.39.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/sanitize-html": "^2.16.1",
    "@typescript-eslint/parser": "^8.68.0",
    "astro-eslint-parser": "^3.1.0",
    "eslint": "9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "remark-cjk-friendly": "^2.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  }
}
