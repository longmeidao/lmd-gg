{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lmd-gg",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-07-31",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  // 站点仍然是 `pnpm build` 出来的静态产物；Worker 只在 /api/* 前面插一脚，
  // 其余路径直接由静态资源服务，不进 Worker。
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },

  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "lmd-gg-media"
    }
  ],

  "vars": {
    "GITHUB_OWNER": "longmeidao",
    "GITHUB_REPO": "lmd-gg",
    "GITHUB_REF": "main",

    // 下面三个要填成你自己的值，见 docs/cloudflare.md
    "ACCESS_TEAM_DOMAIN": "https://REPLACE-ME.cloudflareaccess.com",
    "ACCESS_AUD": "REPLACE-ME",
    "MEDIA_PUBLIC_URL": "https://media.lmd.gg"
  },

  "secrets": {
    "required": ["GITHUB_TOKEN"]
  }

  // 域名先不接管。等在 *.workers.dev 上验证完再打开这段，
  // 否则一部署就会从 Netlify 手里抢走 lmd.gg 的流量。
  //
  // "routes": [{ "pattern": "lmd.gg", "custom_domain": true }]
}
