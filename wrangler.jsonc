{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lmd-gg",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-07-31",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },

  // Worker 仅处理 /api/*，其余路径直接提供静态构建产物。
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
  },

  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "lmd-gg-media",
    },
  ],

  "vars": {
    "GITHUB_OWNER": "longmeidao",
    "GITHUB_REPO": "lmd-gg",
    "GITHUB_REF": "main",

    // Access 应用的团队域名和 AUD。
    "ACCESS_TEAM_DOMAIN": "https://longmeidao.cloudflareaccess.com",
    "ACCESS_AUD": "ca5c2be558643e14cc8515459ed875f65958999d367cdecb6c53acba9c2f6393",

    // 撰写器媒体使用 R2 公开域名；内容图片仍由 Astro 构建处理。
    "MEDIA_PUBLIC_URL": "https://media.lmd.gg",
  },

  // 缺少 GITHUB_TOKEN 时阻止部署。
  "secrets": {
    "required": ["GITHUB_TOKEN"],
  },

  // 自定义域名由 Cloudflare 控制台绑定，不在此处重复配置。
  // "routes": [{ "pattern": "lmd.gg", "custom_domain": true }]
}
